<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)yonder/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
        <BaseOutputPath>$(MSBuildThisFileDirectory)yonder/bin/$(MSBuildProjectName)/</BaseOutputPath>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>
</Project>